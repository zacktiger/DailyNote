# Copy to .env.local and fill in. See docs/auth.md for where each value comes from.
#
# EXPO_PUBLIC_ variables are compiled into the app bundle and are not secret.
# The anon key is designed to be public and is protected by row-level security;
# an OAuth client ID is public by definition. Never put a service-role key here.
#
# Leaving these blank is a supported build: notes and reading the feed work,
# and the sign-in screen says it is not set up.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The *web* OAuth client ID, on Android too. The Android client is matched by
# package name and signing fingerprint and is never named here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
